# ---- 环境（体积大，不入库）----
# runtime/ = 内置的便携 Python 运行时（含全部依赖，约 7.7G）。
# 随项目目录一起分发/搬移，但绝不入库。
runtime/
# .venv 已于 2026-10-14 被 runtime/ 取代，保留规则以防旧环境残留
.venv/
venv/
__pycache__/
*.py[cod]

# ---- 上游源码（独立仓库，见操作教程单独 clone）----
OmniVoice/

# ---- 生成物 / 个人数据 ----
outputs/
voices/
web/_uploads/

# ---- 模型权重（体积大，不入库）----
checkpoints/

# ---- 下载缓存（体积大）----
wheels/*.whl

# ---- 打包产物 ----
dist/
*.zip
*.7z

# ---- Agent 工作目录（项目记忆、一次性脚本、临时文件）----
.workbuddy/

# ---- 界面验证截图：可随时重新生成，脚本本身照常入库 ----
#      （design-review/tools/*.js 与 verify-web/*.js 是入库的）
design-review/**/*.png
